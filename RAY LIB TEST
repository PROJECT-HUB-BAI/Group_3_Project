#include "raylib.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define MAX_ACCOUNTS 500
#define MAX_QUESTS 50
#define MAX_LOGS 200
#define NAME_SIZE 64
#define ID_SIZE 16
#define TEXT_SIZE 128
#define PIN "KSM-321"
#define BASE_XP 100

typedef struct { char id[ID_SIZE], name[NAME_SIZE]; } Account;
typedef struct { char name[NAME_SIZE]; int day, stat, xp, completed; } Quest;
typedef struct {
    char id[ID_SIZE], name[NAME_SIZE];
    int level, xp, statValues[5], effortMinutes[4], todayEffortMinutes[4];
    int effortDate, discipline, questCount, logCount;
    Quest quests[MAX_QUESTS];
    char logs[MAX_LOGS][TEXT_SIZE];
} Player;
typedef enum { HOME, CREATE, LOGIN, DASHBOARD, QUESTS, ADD_QUEST, PROFILE, EFFORT, HISTORY, DEVELOPER } Screen;

static const char *days[] = {"Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"};
static const char *stats[] = {"Intellect","Stamina","Discipline","Social Skills","Creativity"};
static const char *activities[] = {"Study","Fitness","Creativity","Social"};
static const int rewards[] = {10,20,40};
static const char *difficulty[] = {"EASY","MEDIUM","HARD"};
static Account accounts[MAX_ACCOUNTS]; static int accountCount;
static Player player; static Screen screen=HOME;
static int selectedAccount, selectedDay, selectedStat, selectedDifficulty, selectedActivity, effortMinutes=30, historyScroll;
static char nameInput[NAME_SIZE], loginInput[ID_SIZE], questInput[NAME_SIZE], pinInput[TEXT_SIZE];
static char statusText[180]="Your real life is the ultimate adventure. Start your journey!";
static float animationTime;
static Color BG={12,17,31,255}, PANEL={23,32,52,255}, PANEL2={34,47,72,255}, TEAL={63,220,190,255}, BLUE={83,151,255,255}, GOLD={255,194,83,255}, WHITE={239,245,255,255}, MUTED={151,169,195,255}, RED={235,91,112,255}, GREEN={104,222,151,255};

static void Status(const char *s){snprintf(statusText,sizeof(statusText),"%s",s);}
static void AddLog(const char *message){
    time_t now=time(NULL); struct tm *t=localtime(&now); char stamp[32]="time";
    if(t)strftime(stamp,sizeof(stamp),"%Y-%m-%d %H:%M",t);
    if(player.logCount>=MAX_LOGS){memmove(player.logs[0],player.logs[1],(MAX_LOGS-1)*TEXT_SIZE);player.logCount=MAX_LOGS-1;}
    snprintf(player.logs[player.logCount++],TEXT_SIZE,"[%s] %.85s",stamp,message);
}
static void SaveAccounts(void){FILE *f=fopen("accounts.txt","w");if(!f)return;for(int i=0;i<accountCount;i++)fprintf(f,"%s, %s\n",accounts[i].id,accounts[i].name);fclose(f);}
static void LoadAccounts(void){
    FILE *f=fopen("accounts.txt","r");char line[TEXT_SIZE*2];accountCount=0;if(!f)return;
    while(accountCount<MAX_ACCOUNTS&&fgets(line,sizeof(line),f))if(sscanf(line," %15[^,], %63[^\r\n]",accounts[accountCount].id,accounts[accountCount].name)==2)accountCount++;
    fclose(f);
}
static void SavePlayer(void){
    char fileName[32];snprintf(fileName,sizeof(fileName),"%s.txt",player.id);FILE *f=fopen(fileName,"w");if(!f){Status("Could not save progress. Check folder permissions.");return;}
    fprintf(f,"ID: %s\nNAME: %s\nLEVEL: %d\nXP: %d\n",player.id,player.name,player.level,player.xp);
    fprintf(f,"INTELLECTUAL: %d\nSTAMINA: %d\nDISCIPLINE: %d\nSOCIAL: %d\nCREATIVITY: %d\nDISCIPLINE_SCORE: %d\n",player.statValues[0],player.statValues[1],player.statValues[2],player.statValues[3],player.statValues[4],player.discipline);
    fprintf(f,"EFFORT_STUDY: %d\nEFFORT_FITNESS: %d\nEFFORT_CREATIVITY: %d\nEFFORT_SOCIAL: %d\nEFFORT_DAY: %d\n",player.effortMinutes[0],player.effortMinutes[1],player.effortMinutes[2],player.effortMinutes[3],player.effortDate);
    fprintf(f,"TODAY_STUDY: %d\nTODAY_FITNESS: %d\nTODAY_CREATIVITY: %d\nTODAY_SOCIAL: %d\n[QUESTS]\n",player.todayEffortMinutes[0],player.todayEffortMinutes[1],player.todayEffortMinutes[2],player.todayEffortMinutes[3]);
    for(int i=0;i<player.questCount;i++){Quest *q=&player.quests[i];fprintf(f,"QUEST|%d|%d|%d|%d|%s\n",q->day,q->stat,q->xp,q->completed,q->name);}
    fprintf(f,"[ACTIVITY]\n");for(int i=0;i<player.logCount;i++)fprintf(f,"%s\n",player.logs[i]);fclose(f);
}
static int LoadPlayer(const char *id){
    char fileName[32],line[TEXT_SIZE*2],questName[NAME_SIZE];int section=0,n,day,stat,xp,done;
    snprintf(fileName,sizeof(fileName),"%s.txt",id);FILE *f=fopen(fileName,"r");if(!f)return 0;
    memset(&player,0,sizeof(player));snprintf(player.id,ID_SIZE,"%s",id);
    while(fgets(line,sizeof(line),f)){
        line[strcspn(line,"\r\n")]=0;if(!strcmp(line,"[QUESTS]")){section=1;continue;}if(!strcmp(line,"[ACTIVITY]")){section=2;continue;}
        if(section==0){
            if(!strncmp(line,"NAME: ",6))snprintf(player.name,NAME_SIZE,"%s",line+6);
            if(sscanf(line,"LEVEL: %d",&n)==1)player.level=n;if(sscanf(line,"XP: %d",&n)==1)player.xp=n;
            if(sscanf(line,"INTELLECTUAL: %d",&n)==1)player.statValues[0]=n;if(sscanf(line,"STAMINA: %d",&n)==1)player.statValues[1]=n;
            if(sscanf(line,"DISCIPLINE: %d",&n)==1)player.statValues[2]=n;if(sscanf(line,"SOCIAL: %d",&n)==1)player.statValues[3]=n;
            if(sscanf(line,"CREATIVITY: %d",&n)==1)player.statValues[4]=n;if(sscanf(line,"DISCIPLINE_SCORE: %d",&n)==1)player.discipline=n;
            if(sscanf(line,"EFFORT_STUDY: %d",&n)==1)player.effortMinutes[0]=n;if(sscanf(line,"EFFORT_FITNESS: %d",&n)==1)player.effortMinutes[1]=n;
            if(sscanf(line,"EFFORT_CREATIVITY: %d",&n)==1)player.effortMinutes[2]=n;if(sscanf(line,"EFFORT_SOCIAL: %d",&n)==1)player.effortMinutes[3]=n;
            if(sscanf(line,"EFFORT_DAY: %d",&n)==1)player.effortDate=n;if(sscanf(line,"TODAY_STUDY: %d",&n)==1)player.todayEffortMinutes[0]=n;
            if(sscanf(line,"TODAY_FITNESS: %d",&n)==1)player.todayEffortMinutes[1]=n;if(sscanf(line,"TODAY_CREATIVITY: %d",&n)==1)player.todayEffortMinutes[2]=n;
            if(sscanf(line,"TODAY_SOCIAL: %d",&n)==1)player.todayEffortMinutes[3]=n;
        }else if(section==1&&player.questCount<MAX_QUESTS){
            if(sscanf(line,"QUEST|%d|%d|%d|%d|%63[^\n]",&day,&stat,&xp,&done,questName)==5){Quest *q=&player.quests[player.questCount++];q->day=day>=0&&day<7?day:0;q->stat=stat>=0&&stat<5?stat:0;q->xp=xp;q->completed=done;snprintf(q->name,NAME_SIZE,"%s",questName);}
        }else if(section==2&&player.logCount<MAX_LOGS&&line[0])snprintf(player.logs[player.logCount++],TEXT_SIZE,"%s",line);
    }
    fclose(f);if(player.level<1)player.level=1;return 1;
}
static void NewPlayer(const char *id,const char *name){memset(&player,0,sizeof(player));snprintf(player.id,ID_SIZE,"%s",id);snprintf(player.name,NAME_SIZE,"%s",name);player.level=1;for(int i=0;i<5;i++)player.statValues[i]=10;AddLog("Account created. Welcome to LIFE RPG!");}
static void AddXP(int amount){player.xp+=amount;while(player.xp>=player.level*BASE_XP){player.xp-=player.level*BASE_XP;player.level++;AddLog("LEVEL UP! A new level unlocked.");}}
static int TodayKey(void){time_t now=time(NULL);struct tm *t=localtime(&now);return t?(t->tm_year+1900)*1000+t->tm_yday:0;}
static void PrepareEffort(void){if(player.effortDate!=TodayKey()){player.effortDate=TodayKey();for(int i=0;i<4;i++)player.todayEffortMinutes[i]=0;}}
static int TodayTotal(void){int n=0;for(int i=0;i<4;i++)n+=player.todayEffortMinutes[i];return n;}
static int TotalEffort(void){int n=0;for(int i=0;i<4;i++)n+=player.effortMinutes[i];return n;}
static void CreateAccount(void){
    if(accountCount>=MAX_ACCOUNTS){Status("Account limit reached.");return;}if(!nameInput[0]){Status("Please enter your name first.");return;}
    char id[ID_SIZE];int duplicate;do{snprintf(id,sizeof(id),"KSM-%04d",1000+rand()%9000);duplicate=0;for(int i=0;i<accountCount;i++)if(!strcmp(accounts[i].id,id))duplicate=1;}while(duplicate);
